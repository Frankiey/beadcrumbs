{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^bc-[0-9a-f]{12}4[0-9a-f]{3}[89ab][0-9a-f]{15}(?![\\s\\S])"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "acceptance_criteria": {
      "type": "string"
    },
    "state": {
      "enum": [
        "open",
        "claimed",
        "closed"
      ]
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^bc-[0-9a-f]{12}4[0-9a-f]{3}[89ab][0-9a-f]{15}(?![\\s\\S])"
      },
      "uniqueItems": true
    },
    "claim": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])"
            },
            "token": {
              "type": "string",
              "pattern": "^[0-9a-f]{12}4[0-9a-f]{3}[89ab][0-9a-f]{15}(?![\\s\\S])"
            }
          },
          "required": [
            "agent",
            "token"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
          },
          "by": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "at",
          "by",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "title",
    "description",
    "acceptance_criteria",
    "state",
    "depends_on",
    "claim",
    "notes",
    "created_at",
    "updated_at",
    "revision"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "claimed"
          }
        }
      },
      "then": {
        "properties": {
          "claim": {
            "type": "object",
            "properties": {
              "agent": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])"
              },
              "token": {
                "type": "string",
                "pattern": "^[0-9a-f]{12}4[0-9a-f]{3}[89ab][0-9a-f]{15}(?![\\s\\S])"
              }
            },
            "required": [
              "agent",
              "token"
            ],
            "additionalProperties": false
          }
        }
      },
      "else": {
        "properties": {
          "claim": {
            "type": "null"
          }
        }
      }
    }
  ]
}
