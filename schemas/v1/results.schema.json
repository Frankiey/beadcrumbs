{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "issues": {
      "type": "array",
      "items": {
        "$ref": "issue.schema.json"
      }
    },
    "blocked": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue": {
            "$ref": "issue.schema.json"
          },
          "blockers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^bc-[0-9a-f]{12}4[0-9a-f]{3}[89ab][0-9a-f]{15}(?![\\s\\S])"
                },
                "state": {
                  "enum": [
                    "open",
                    "claimed"
                  ]
                }
              },
              "required": [
                "id",
                "state"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "issue",
          "blockers"
        ],
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "valid": {
          "const": true
        },
        "issue_count": {
          "type": "integer",
          "minimum": 0
        },
        "epic_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "valid",
        "issue_count",
        "epic_count"
      ],
      "additionalProperties": false
    },
    "board": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "issue_count": {
          "type": "integer",
          "minimum": 0
        },
        "epic_count": {
          "type": "integer",
          "minimum": 0
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "path",
        "issue_count",
        "epic_count",
        "generated_at"
      ],
      "additionalProperties": false
    },
    "epics": {
      "type": "array",
      "items": {
        "$ref": "epic.schema.json"
      }
    },
    "epic_detail": {
      "type": "object",
      "properties": {
        "epic": {
          "$ref": "epic.schema.json"
        },
        "counts": {
          "type": "object",
          "properties": {
            "ready": {
              "type": "integer",
              "minimum": 0
            },
            "blocked": {
              "type": "integer",
              "minimum": 0
            },
            "claimed": {
              "type": "integer",
              "minimum": 0
            },
            "closed": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "ready",
            "blocked",
            "claimed",
            "closed"
          ],
          "additionalProperties": false
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "issue.schema.json"
          }
        }
      },
      "required": [
        "epic",
        "counts",
        "issues"
      ],
      "additionalProperties": false
    }
  }
}
